# Optional server-owned provider key. Prefer each reader's private browser-session
# key in the app's AI settings. Never commit a real API key.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LINE Messaging API (optional)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Stripe subscription billing (optional; use test-mode credentials first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_CORPORATE_MONTHLY=
BILLING_SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# Supabase account + three-day trial. The app uses its own iching_ai_app_ tables
# and does not change shared Supabase Auth settings for other applications.
# URL and publishable key are browser-safe; all account tables remain protected
# by RLS and only the two narrowly-scoped RPCs can be called anonymously.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ICHING_AI_APP_AUTH_SECRET=
CRON_SECRET=
