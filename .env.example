# Optional server-owned provider key. Prefer each reader's private browser-session
# key in the app's AI settings. Never commit a real API key.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LINE Messaging API (optional)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Stripe subscription billing (optional; use test-mode credentials first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_CORPORATE_MONTHLY=
BILLING_SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# Supabase login + three-day trial. Create a dedicated project in Northeast Asia
# (Tokyo) ap-northeast-1, disable Auth > Email > Confirm email for immediate
# email/password onboarding, and run supabase/schema.sql once in SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used only by the scheduled health check; never prefix this key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
